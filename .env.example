# Application Settings
APP_NAME=Continuous Internal Audit KRI Engine
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Settings
# The SQLite file is created next to the project root on first run.
DATABASE_URL=sqlite:///./kri_audit.db

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# LLM Execution Settings
USE_MOCK_LLM=true
MAX_TOOL_CALLS_PER_RUN=15
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.0
SSL_VERIFY=false

# --- Plan Interpretation -------------------------------------------------------
# How natural language test steps are translated into a structured execution plan.
#   rules  - deterministic keyword interpreter only (never calls the LLM)
#   llm    - the LLM classifies each step; deterministic resolvers own all parameters
#   hybrid - LLM when Azure is configured, keyword rules as the fallback
# Note: with USE_MOCK_LLM=true, or without Azure credentials, the effective mode
# degrades to `rules` automatically. GetInterpreterMode() reports the real value.
PLAN_INTERPRETER=hybrid

# When true, a step the agent cannot resolve unambiguously is a hard error (422) and the
# write is rolled back. There is no silent default operation and no silent default source.
STRICT_INTERPRETATION=true

# Stamped onto each persisted plan version so a plan derived under an older prompt or
# model can be identified and regenerated.
PLAN_PROMPT_VERSION=planner-v2

# Regenerate the execution plan automatically whenever the steps, data source
# assignment, thresholds or end goal change. This is what keeps the plan in sync
# with the configuration it was derived from.
AUTO_REGENERATE_PLANS=true

# --- Execution ----------------------------------------------------------------
# plan  - deterministic plan executor: tools are dispatched from the stored plan
# agent - legacy free-form LLM tool-dispatch loop (kept only for side-by-side
#         comparison during rollout; do not use in production)
EXECUTION_MODE=plan

# Logging
LOGS_DIR=logs/runs
